    private CacheManager cacheManager;

    @Scheduled(fixedDelay = 60000)  // Every minute
    public void logCacheStats() {
        for (String cacheName : cacheManager.getCacheNames()) {
            Cache cache = cacheManager.getCache(cacheName);

            if (cache.getNativeCache() instanceof MultiTierCache) {
                MultiTierCache multiTierCache = (MultiTierCache) cache.getNativeCache();
                var stats = multiTierCache.getLocalCacheStats();

                log.info("Cache: {} - Hit Rate: {}%, Size: {}, Evictions: {}",
                    cacheName,
                    String.format("%.2f", stats.hitRate() * 100),
                    stats.estimatedSize(),
                    stats.evictionCount()
                );
            }
        }
    }
