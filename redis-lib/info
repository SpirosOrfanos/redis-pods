2. Custom Multi-Tier Cache Manager OK
java
@Component
public class MultiTierCacheManager implements CacheManager {

    private final ConcurrentHashMap<String, Cache> caches = new ConcurrentHashMap<>();
    private final RedisTemplate<String, Object> redisTemplate;
    private final Caffeine<Object, Object> caffeineBuilder;

    public MultiTierCacheManager(RedisConnectionFactory connectionFactory) {
        // Setup Redis
        this.redisTemplate = new RedisTemplate<>();
        this.redisTemplate.setConnectionFactory(connectionFactory);
        this.redisTemplate.setKeySerializer(new StringRedisSerializer());
        this.redisTemplate.setValueSerializer(new GenericJackson2JsonRedisSerializer());
        this.redisTemplate.afterPropertiesSet();

        // Setup Caffeine configuration
        this.caffeineBuilder = Caffeine.newBuilder()
            .maximumSize(10000)
            .expireAfterWrite(1, TimeUnit.MINUTES)  // L1 expires quickly
            .recordStats();  // For monitoring
    }

    @Override
    public Cache getCache(String name) {
        return caches.computeIfAbsent(name, this::createMultiTierCache);
    }

    private Cache createMultiTierCache(String name) {
        return new MultiTierCache(name, redisTemplate,
            caffeineBuilder.buildAsync().synchronous());
    }

    @Override
    public Collection<String> getCacheNames() {
        return caches.keySet();
    }

    // Inner class implementing the two-tier cache logic
    private static class MultiTierCache implements Cache {
        private final String name;
        private final RedisTemplate<String, Object> redisTemplate;
        private final com.github.benmanes.caffeine.cache.Cache<Object, Object> localCache;
        private final String REDIS_KEY_PREFIX = "cache::";

        public MultiTierCache(String name, RedisTemplate<String, Object> redisTemplate,
                              com.github.benmanes.caffeine.cache.Cache<Object, Object> localCache) {
            this.name = name;
            this.redisTemplate = redisTemplate;
            this.localCache = localCache;
        }

        @Override
        public String getName() {
            return name;
        }

        @Override
        public Object getNativeCache() {
            return this;
        }

        @Override
        public ValueWrapper get(Object key) {
            Object value = get(key);
            return value != null ? () -> value : null;
        }

        @Override
        public <T> T get(Object key, Class<T> type) {
            Object value = get(key);
            return type.cast(value);
        }

        private Object get(Object key) {
            String cacheKey = buildKey(key);

            // L1: Check local Caffeine cache first (nanoseconds)
            Object value = localCache.getIfPresent(cacheKey);
            if (value != null) {
                return value;
            }

            // L2: Check Redis (milliseconds)
            value = redisTemplate.opsForValue().get(cacheKey);
            if (value != null) {
                // Populate L1 for future requests
                localCache.put(cacheKey, value);
                return value;
            }

            return null;
        }

        @Override
        public void put(Object key, Object value) {
            String cacheKey = buildKey(key);

            // Write to both caches
            localCache.put(cacheKey, value);
            redisTemplate.opsForValue().set(cacheKey, value, 10, TimeUnit.MINUTES);

            // Publish invalidation message to other pods
            publishInvalidation(cacheKey);
        }

        @Override
        public void evict(Object key) {
            String cacheKey = buildKey(key);
            localCache.invalidate(cacheKey);
            redisTemplate.delete(cacheKey);
            publishInvalidation(cacheKey);
        }

        @Override
        public void clear() {
            localCache.invalidateAll();
            Set<String> keys = redisTemplate.keys(REDIS_KEY_PREFIX + name + "::*");
            if (keys != null && !keys.isEmpty()) {
                redisTemplate.delete(keys);
            }
            publishClear();
        }

        private String buildKey(Object key) {
            return REDIS_KEY_PREFIX + name + "::" + key.toString();
        }

        private void publishInvalidation(String cacheKey) {
            InvalidationMessage message = new InvalidationMessage(
                InvalidationMessage.Type.EVICT,
                name,
                cacheKey
            );
            redisTemplate.convertAndSend("cache-invalidation", message);
        }

        private void publishClear() {
            InvalidationMessage message = new InvalidationMessage(
                InvalidationMessage.Type.CLEAR,
                name,
                null
            );
            redisTemplate.convertAndSend("cache-invalidation", message);
        }
    }
}
3. Redis Pub/Sub Message Listener for Cross-Pod Invalidation
java
@Component
public class CacheInvalidationListener implements MessageListener {

    private final Map<String, MultiTierCacheManager.MultiTierCache> caches = new ConcurrentHashMap<>();

    @Autowired
    private ApplicationContext applicationContext;

    @EventListener(ApplicationReadyEvent.class)
    public void registerCaches() {
        MultiTierCacheManager cacheManager = applicationContext.getBean(MultiTierCacheManager.class);
        // Store reference to caches for invalidation
    }

    @Override
    public void onMessage(Message message, byte[] pattern) {
        try {
            InvalidationMessage invalidation = (InvalidationMessage)
                redisTemplate.getValueSerializer().deserialize(message.getBody());

            if (invalidation != null) {
                handleInvalidation(invalidation);
            }
        } catch (Exception e) {
            // Log error but don't break the flow
        }
    }

    private void handleInvalidation(InvalidationMessage invalidation) {
        // Get the cache from your cache manager
        Cache cache = cacheManager.getCache(invalidation.getCacheName());

        if (cache != null && cache.getNativeCache() instanceof MultiTierCache) {
            MultiTierCache multiTierCache = (MultiTierCache) cache.getNativeCache();

            if (invalidation.getType() == InvalidationMessage.Type.EVICT) {
                // Only invalidate L1 cache, keep L2 (Redis) as source of truth
                multiTierCache.invalidateLocalOnly(invalidation.getKey());
            } else if (invalidation.getType() == InvalidationMessage.Type.CLEAR) {
                multiTierCache.clearLocalOnly();
            }
        }
    }
}

// Message DTO OK
@Data
@NoArgsConstructor
@AllArgsConstructor
public class InvalidationMessage implements Serializable {
    public enum Type { EVICT, CLEAR }
    private Type type;
    private String cacheName;
    private String key;
}
4. Enhanced MultiTierCache with Local Invalidation
java
private static class MultiTierCache implements Cache {
    // ... existing fields ...

    public void invalidateLocalOnly(String key) {
        // Only invalidate L1, L2 (Redis) remains
        localCache.invalidate(key);
    }

    public void clearLocalOnly() {
        localCache.invalidateAll();
    }

    // Modified get method to handle stale data gracefully
    private Object get(Object key, CacheLoader<Object, Object> loader) {
        String cacheKey = buildKey(key);

        // L1: Check local cache
        Object value = localCache.getIfPresent(cacheKey);
        if (value != null) {
            return value;
        }

        // L2: Check Redis
        value = redisTemplate.opsForValue().get(cacheKey);
        if (value != null) {
            localCache.put(cacheKey, value);
            return value;
        }

        // L3: Load from database (via provided loader)
        if (loader != null) {
            value = loader.load(key);
            if (value != null) {
                put(key, value);
            }
        }

        return value;
    }
}
